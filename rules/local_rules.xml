<!--
  Custom Wazuh detection rules for the SOC Detection Lab.
  Deployed on the Wazuh manager at /var/ossec/etc/rules/local_rules.xml
-->

<!-- T1110 - RDP brute force: frequency correlation of failed logons -->
<group name="windows,authentication_failures,rdp,">
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <description>RDP brute-force attack: 5 or more failed logons within 120 seconds.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>
</group>

<!-- T1136 - Backdoor admin: a new account added to Administrators shortly after creation -->
<group name="windows,account_changes,">
  <rule id="100200" level="14" timeframe="120">
    <if_sid>60154</if_sid>
    <if_matched_sid>60109</if_matched_sid>
    <description>Backdoor admin: a newly created account was added to Administrators within 120 seconds (possible persistence).</description>
    <mitre>
      <id>T1136</id>
      <id>T1098</id>
    </mitre>
    <group>account_changes,pci_dss_10.2.5,</group>
  </rule>
</group>
